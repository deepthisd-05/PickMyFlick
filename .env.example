# GEMINI_API_KEY: Required for optional natural-language recommendation explanations via Gemini.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TMDB_API_KEY: Optional TMDB API v3 key for live trending/popular/upcoming movies and posters.
# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=""

# TMDB_READ_ACCESS_TOKEN: Optional TMDB v4 Bearer token (alternative to TMDB_API_KEY).
TMDB_READ_ACCESS_TOKEN=""

# SESSION_SECRET: Secret key used to sign authentication session cookies.
SESSION_SECRET="dev-session-secret-change-in-production"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
